{
  "typography": {
    "weight": {
      "bold":     { "$value": "700", "$type": "fontWeights" },
      "semibold": { "$value": "600", "$type": "fontWeights" },
      "regular":  { "$value": "400", "$type": "fontWeights" }
    },
    "size": {
      "12": { "$value": "12px", "$type": "fontSizes" },
      "14": { "$value": "14px", "$type": "fontSizes" },
      "16": { "$value": "16px", "$type": "fontSizes" },
      "18": { "$value": "18px", "$type": "fontSizes" },
      "20": { "$value": "20px", "$type": "fontSizes" },
      "24": { "$value": "24px", "$type": "fontSizes" },
      "28": { "$value": "28px", "$type": "fontSizes" },
      "32": { "$value": "32px", "$type": "fontSizes" }
    },
    "lineHeight": {
      "16": { "$value": "16px", "$type": "lineHeights" },
      "18": { "$value": "18px", "$type": "lineHeights" },
      "22": { "$value": "22px", "$type": "lineHeights" },
      "24": { "$value": "24px", "$type": "lineHeights" },
      "26": { "$value": "26px", "$type": "lineHeights" },
      "30": { "$value": "30px", "$type": "lineHeights" },
      "36": { "$value": "36px", "$type": "lineHeights" },
      "42": { "$value": "42px", "$type": "lineHeights" },
      "48": { "$value": "48px", "$type": "lineHeights" }
    },
    "letterSpacing": {
      "wide":    { "$value": "-1.5%", "$type": "letterSpacing" },
      "default": { "$value": "-2%",   "$type": "letterSpacing" }
    }
  }
}
